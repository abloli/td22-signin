#!name=猛将OL签到
#!desc=猛将OL游戏每日签到，多账号自动签到，可在插件设置里改时间
#!author=abloli
#!icon=checkmark.circle

[Rewrite]
^https://sb\.td22\.com/ac/20240920/index\.aspx script-path=https://raw.githubusercontent.com/abloli/td22-signin/main/td22-capture.js, requires-body=0, timeout=10, tag=猛将OL抓Cookie

[Script]
cron "0 * * * *" script-path=https://raw.githubusercontent.com/abloli/td22-signin/main/td22-signin.js, tag=猛将OL签到, timeout=60, argument="time=9:05"

[Rewrite]
http-request ^https://sb\.td22\.com/ac/20240920/index\.aspx script-path=https://cdn.jsdelivr.net/gh/abloli/td22-signin@29e7599/td22-capture.js, enabled=true, tag=猛将OL抓Cookie
http-request ^https://user\.td22\.com/.* script-path=https://cdn.jsdelivr.net/gh/abloli/td22-signin@29e7599/td22-capture.js, enabled=true, tag=猛将OL抓Cookie登录

[Script]
cron "5 9 * * *" script-path=https://cdn.jsdelivr.net/gh/abloli/td22-signin@main/td22-signin.js, tag=猛将OL签到, timeout=60
cron "0 0 1 1 *" script-path=https://cdn.jsdelivr.net/gh/abloli/td22-signin@29e7599/td22-capture.js, tag=猛将OL抓Cookie, timeout=10

[MITM]
hostname = sb.td22.com, user.td22.com

#!name=猛将OL签到
#!desc=猛将OL游戏每日签到，多账号自动签到
#!author=iloli
#!icon=checkmark.circle

[Script]
cron "5 9 * * *" script-path=https://raw.githubusercontent.com/abloli/td22-signin/main/td22-checkin.js, timeout=60, enabled=true, tag=猛将OL签到
http-request ^https?://(sb|user)\.td22\.com/ script-path=https://raw.githubusercontent.com/abloli/td22-signin/main/td22-checkin.js, timeout=10, enabled=true, tag=猛将OL抓Cookie

[MITM]
hostname = sb.td22.com, user.td22.com
